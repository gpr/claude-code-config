#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""session-token: report the token consumption of a Claude Code session.

Reads the session's JSONL transcript (and any subagent transcripts spawned
from it) under ~/.claude/projects/, and reports total in/out/cached tokens
including subagents, plus a breakdown per subagent/skill/tool, thinking
usage, and turn counts.

Usage:
    ./scripts/session-token <session-id> [--format md|json]
"""
from __future__ import annotations

import argparse
import json
import os
from collections import defaultdict
from dataclasses import dataclass, field
from pathlib import Path

CLAUDE_DIR = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude"))
PROJECTS_DIR = CLAUDE_DIR / "projects"


@dataclass
class Usage:
    input_tokens: float = 0
    output_tokens: float = 0
    cache_creation_tokens: float = 0
    cache_read_tokens: float = 0
    turns: int = 0  # number of assistant messages (API calls)

    def add(self, other: "Usage") -> None:
        self.input_tokens += other.input_tokens
        self.output_tokens += other.output_tokens
        self.cache_creation_tokens += other.cache_creation_tokens
        self.cache_read_tokens += other.cache_read_tokens
        self.turns += other.turns

    def add_raw(self, usage: dict, count_turn: bool = True) -> None:
        self.input_tokens += usage.get("input_tokens", 0) or 0
        self.output_tokens += usage.get("output_tokens", 0) or 0
        self.cache_creation_tokens += usage.get("cache_creation_input_tokens", 0) or 0
        self.cache_read_tokens += usage.get("cache_read_input_tokens", 0) or 0
        if count_turn:
            self.turns += 1

    @property
    def total(self) -> float:
        return (
            self.input_tokens
            + self.output_tokens
            + self.cache_creation_tokens
            + self.cache_read_tokens
        )


@dataclass
class SessionReport:
    session_id: str
    models: set = field(default_factory=set)
    total: Usage = field(default_factory=Usage)
    main: Usage = field(default_factory=Usage)
    by_subagent: dict = field(default_factory=lambda: defaultdict(Usage))
    subagent_invocations: dict = field(default_factory=lambda: defaultdict(int))
    by_tool: dict = field(default_factory=lambda: defaultdict(Usage))
    tool_calls: dict = field(default_factory=lambda: defaultdict(int))
    by_skill: dict = field(default_factory=lambda: defaultdict(Usage))
    skill_calls: dict = field(default_factory=lambda: defaultdict(int))
    thinking_blocks: int = 0
    thinking_chars: int = 0
    human_turns: int = 0
    assistant_turns_main: int = 0
    assistant_turns_total: int = 0


def find_session_files(session_id: str) -> tuple[Path, Path | None]:
    """Return (main_transcript_path, subagents_dir_or_None)."""
    if not PROJECTS_DIR.is_dir():
        raise SystemExit(f"error: projects directory not found: {PROJECTS_DIR}")
    for project_dir in PROJECTS_DIR.iterdir():
        if not project_dir.is_dir():
            continue
        main_file = project_dir / f"{session_id}.jsonl"
        if main_file.exists():
            subagents_dir = project_dir / session_id / "subagents"
            return main_file, subagents_dir if subagents_dir.is_dir() else None
    raise SystemExit(f"error: no session found with id {session_id!r} under {PROJECTS_DIR}")


def iter_records(path: Path):
    with path.open() as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                yield json.loads(line)
            except json.JSONDecodeError:
                continue


def is_human_turn(record: dict) -> bool:
    if record.get("type") != "user":
        return False
    if record.get("isSidechain"):
        return False
    content = record.get("message", {}).get("content")
    if isinstance(content, str):
        return bool(content.strip())
    if isinstance(content, list):
        return any(block.get("type") != "tool_result" for block in content)
    return False


def collect_prompt_to_type_map(records: list[dict]) -> dict[str, str]:
    """Map an Agent/Task tool_use's exact prompt text -> subagent_type.

    A spawned subagent's transcript file starts with a user record whose
    content is verbatim the `prompt` the caller passed to the Agent/Task
    tool. That's the only reliable link back to the caller: the tool_result
    only echoes an `agentId:` line for agents left open for follow-up
    (SendMessage), not for ones that ran to completion inline.
    """
    prompt_to_type: dict[str, str] = {}
    for record in records:
        if record.get("type") != "assistant":
            continue
        content = record.get("message", {}).get("content")
        if not isinstance(content, list):
            continue
        for block in content:
            if block.get("type") == "tool_use" and block.get("name") in ("Agent", "Task"):
                inp = block.get("input", {})
                prompt = inp.get("prompt")
                if prompt:
                    prompt_to_type[prompt] = inp.get("subagent_type") or inp.get(
                        "name", "unknown"
                    )
    return prompt_to_type


def first_user_text(records: list[dict]) -> str | None:
    for record in records:
        if record.get("type") != "user":
            continue
        content = record.get("message", {}).get("content")
        if isinstance(content, str):
            return content
        if isinstance(content, list):
            for block in content:
                if block.get("type") == "text":
                    return block.get("text")
    return None


def merge_assistant_turns(records: list[dict]) -> list[dict]:
    """Reassemble logical assistant turns from the transcript.

    Claude Code writes one JSONL record per content block of a multi-block
    assistant turn (thinking/text/tool_use, or several parallel tool_use
    calls), and every one of those records repeats the *same* full-turn
    `usage` — so summing usage record-by-record overcounts input/output/
    cache tokens by however many blocks a turn happened to have. Records
    belonging to the same turn share `message.id`; merge their content
    blocks back together and keep the (identical) usage/model only once.
    """
    merged: dict[str, dict] = {}
    order: list[str] = []
    for record in records:
        if record.get("type") != "assistant":
            continue
        message = record.get("message", {})
        content = message.get("content")
        if not isinstance(content, list):
            continue
        msg_id = message.get("id")
        if msg_id not in merged:
            merged[msg_id] = {
                "model": message.get("model"),
                "usage": message.get("usage") or {},
                "content": [],
            }
            order.append(msg_id)
        merged[msg_id]["content"].extend(content)
    return [merged[msg_id] for msg_id in order]


def process_records(
    records: list[dict],
    report: SessionReport,
    *,
    is_main: bool,
    subagent_label: str | None,
) -> None:
    if is_main:
        for record in records:
            if record.get("type") == "user" and is_human_turn(record):
                report.human_turns += 1

    for turn_data in merge_assistant_turns(records):
        content = turn_data["content"]
        model = turn_data["model"]
        if model:
            report.models.add(model)

        usage = turn_data["usage"]
        turn = Usage()
        turn.add_raw(usage, count_turn=True)

        report.total.add(turn)
        if is_main:
            report.main.add(turn)
            report.assistant_turns_main += 1
        else:
            report.by_subagent[subagent_label].add(turn)
        report.assistant_turns_total += 1

        thinking_blocks = [b for b in content if b.get("type") == "thinking"]
        tool_blocks = [b for b in content if b.get("type") == "tool_use"]

        for block in thinking_blocks:
            report.thinking_blocks += 1
            report.thinking_chars += len(block.get("thinking", ""))

        if tool_blocks:
            share = Usage(
                input_tokens=turn.input_tokens / len(tool_blocks),
                output_tokens=turn.output_tokens / len(tool_blocks),
                cache_creation_tokens=turn.cache_creation_tokens / len(tool_blocks),
                cache_read_tokens=turn.cache_read_tokens / len(tool_blocks),
                turns=0,
            )
            for block in tool_blocks:
                name = block.get("name", "unknown")
                report.by_tool[name].add(share)
                report.tool_calls[name] += 1
                if name == "Skill":
                    skill_name = block.get("input", {}).get("skill", "unknown")
                    report.by_skill[skill_name].add(share)
                    report.skill_calls[skill_name] += 1
                if name in ("Agent", "Task"):
                    sub_type = block.get("input", {}).get("subagent_type") or block.get(
                        "input", {}
                    ).get("name", "unknown")
                    report.subagent_invocations[sub_type] += 1


def build_report(session_id: str) -> SessionReport:
    main_file, subagents_dir = find_session_files(session_id)
    report = SessionReport(session_id=session_id)

    main_records = list(iter_records(main_file))
    process_records(main_records, report, is_main=True, subagent_label=None)

    if subagents_dir is not None:
        sub_files = sorted(subagents_dir.glob("agent-*.jsonl"))
        all_sub_records = {f: list(iter_records(f)) for f in sub_files}

        # Build the prompt->subagent_type map from every transcript that can
        # spawn agents: the main session plus every subagent file (an agent
        # may itself spawn further agents into the same flat subagents/ dir).
        prompt_to_type: dict[str, str] = collect_prompt_to_type_map(main_records)
        for sub_records in all_sub_records.values():
            prompt_to_type.update(collect_prompt_to_type_map(sub_records))

        for sub_file, sub_records in all_sub_records.items():
            prompt = first_user_text(sub_records)
            label = prompt_to_type.get(prompt, "unknown") if prompt else "unknown"
            process_records(sub_records, report, is_main=False, subagent_label=label)

    return report


def render_markdown(r: SessionReport) -> str:
    lines: list[str] = []
    lines.append(f"# Token report — session `{r.session_id}`")
    lines.append("")
    if r.models:
        lines.append(f"**Model(s):** {', '.join(sorted(r.models))}")
        lines.append("")

    def fmt(n: float) -> str:
        return f"{round(n):,}"

    lines.append("## Total (including subagents)")
    lines.append("")
    lines.append("| in | out | cache write | cache read | total |")
    lines.append("|---|---|---|---|---|")
    lines.append(
        f"| {fmt(r.total.input_tokens)} | {fmt(r.total.output_tokens)} | "
        f"{fmt(r.total.cache_creation_tokens)} | {fmt(r.total.cache_read_tokens)} | "
        f"{fmt(r.total.total)} |"
    )
    lines.append("")

    lines.append("## By agent")
    lines.append("")
    lines.append("| agent | calls | in | out | cache write | cache read | total |")
    lines.append("|---|---|---|---|---|---|---|")
    lines.append(
        f"| main | {r.assistant_turns_main} | {fmt(r.main.input_tokens)} | "
        f"{fmt(r.main.output_tokens)} | {fmt(r.main.cache_creation_tokens)} | "
        f"{fmt(r.main.cache_read_tokens)} | {fmt(r.main.total)} |"
    )
    for label, usage in sorted(r.by_subagent.items(), key=lambda kv: -kv[1].total):
        invocations = r.subagent_invocations.get(label, usage.turns)
        lines.append(
            f"| {label} ({invocations} invocation{'s' if invocations != 1 else ''}) | "
            f"{usage.turns} | {fmt(usage.input_tokens)} | {fmt(usage.output_tokens)} | "
            f"{fmt(usage.cache_creation_tokens)} | {fmt(usage.cache_read_tokens)} | "
            f"{fmt(usage.total)} |"
        )
    lines.append("")

    if r.by_tool:
        lines.append("## By tool")
        lines.append(
            "_Tokens are the enclosing turn's usage, split evenly across the "
            "tool calls it made — approximate, not an exact per-tool cost._"
        )
        lines.append("")
        lines.append("| tool | calls | in | out | cache write | cache read | total |")
        lines.append("|---|---|---|---|---|---|---|")
        for name, usage in sorted(r.by_tool.items(), key=lambda kv: -kv[1].total):
            calls = r.tool_calls[name]
            lines.append(
                f"| {name} | {calls} | {fmt(usage.input_tokens)} | "
                f"{fmt(usage.output_tokens)} | {fmt(usage.cache_creation_tokens)} | "
                f"{fmt(usage.cache_read_tokens)} | {fmt(usage.total)} |"
            )
        lines.append("")

    if r.by_skill:
        lines.append("## By skill")
        lines.append("")
        lines.append("| skill | calls | in | out | cache write | cache read | total |")
        lines.append("|---|---|---|---|---|---|---|")
        for name, usage in sorted(r.by_skill.items(), key=lambda kv: -kv[1].total):
            calls = r.skill_calls[name]
            lines.append(
                f"| {name} | {calls} | {fmt(usage.input_tokens)} | "
                f"{fmt(usage.output_tokens)} | {fmt(usage.cache_creation_tokens)} | "
                f"{fmt(usage.cache_read_tokens)} | {fmt(usage.total)} |"
            )
        lines.append("")

    lines.append("## Thinking")
    lines.append("")
    est_tokens = r.thinking_chars // 4
    lines.append(f"- Thinking blocks: {r.thinking_blocks}")
    lines.append(f"- Thinking chars: {fmt(r.thinking_chars)} (~{fmt(est_tokens)} tokens est.)")
    lines.append(
        "- Note: thinking tokens are already counted inside each turn's `output` "
        "tokens above — this is a breakout, not additional tokens."
    )
    lines.append("")

    lines.append("## Turns")
    lines.append("")
    lines.append(f"- Human turns (main session prompts): {r.human_turns}")
    lines.append(f"- Assistant turns (main agent, API calls): {r.assistant_turns_main}")
    lines.append(f"- Assistant turns (including subagents): {r.assistant_turns_total}")
    total_subagent_invocations = sum(r.subagent_invocations.values())
    lines.append(f"- Subagent invocations: {total_subagent_invocations}")

    return "\n".join(lines) + "\n"


def render_json(r: SessionReport) -> str:
    def usage_dict(u: Usage) -> dict:
        return {
            "input_tokens": round(u.input_tokens),
            "output_tokens": round(u.output_tokens),
            "cache_creation_tokens": round(u.cache_creation_tokens),
            "cache_read_tokens": round(u.cache_read_tokens),
            "total_tokens": round(u.total),
            "turns": u.turns,
        }

    payload = {
        "session_id": r.session_id,
        "models": sorted(r.models),
        "total": usage_dict(r.total),
        "by_agent": {
            "main": {**usage_dict(r.main), "turns": r.assistant_turns_main},
            **{
                label: {
                    **usage_dict(usage),
                    "invocations": r.subagent_invocations.get(label, usage.turns),
                }
                for label, usage in r.by_subagent.items()
            },
        },
        "by_tool": {
            name: {**usage_dict(usage), "calls": r.tool_calls[name]}
            for name, usage in r.by_tool.items()
        },
        "by_skill": {
            name: {**usage_dict(usage), "calls": r.skill_calls[name]}
            for name, usage in r.by_skill.items()
        },
        "thinking": {
            "blocks": r.thinking_blocks,
            "chars": r.thinking_chars,
            "estimated_tokens": r.thinking_chars // 4,
            "note": "already included in each turn's output_tokens above",
        },
        "turns": {
            "human_turns_main": r.human_turns,
            "assistant_turns_main": r.assistant_turns_main,
            "assistant_turns_total": r.assistant_turns_total,
            "subagent_invocations": sum(r.subagent_invocations.values()),
        },
    }
    return json.dumps(payload, indent=2)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Report token consumption for a Claude Code session."
    )
    parser.add_argument("session_id", help="Session id (UUID) to report on")
    parser.add_argument(
        "--format",
        choices=["md", "json"],
        default="md",
        help="Output format (default: md)",
    )
    args = parser.parse_args()

    report = build_report(args.session_id)
    if args.format == "json":
        print(render_json(report))
    else:
        print(render_markdown(report))


if __name__ == "__main__":
    main()
