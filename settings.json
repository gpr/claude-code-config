  "model": "opus",
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(jq -r '.tool_input.command'); if echo \"$CMD\" | grep -qiE '(^|[[:space:]])-[a-zA-Z]*[rR]' && echo \"$CMD\" | grep -qiE '(^|[[:space:]])-[a-zA-Z]*[fF]'; then echo 'BLOCKED: Use trash instead of rm -rf' >&2; exit 2; fi",
            "if": "Bash(rm *)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(jq -r '.tool_input.command'); case \"$CMD\" in grep\\ *|grep) echo 'BLOCKED: Use the Grep tool or rg instead of grep' >&2; exit 2;; head\\ *|head) echo 'BLOCKED: Use the Read tool instead of head' >&2; exit 2;; tail\\ *|tail) echo 'BLOCKED: Use the Read tool instead of tail' >&2; exit 2;; esac"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/gregory.rome/.claude/scripts/statusline.sh"
  },
